# Copy to .env and adjust for local development:
#   cp .env.example .env

# --- Database ---
DATABASE_URL=postgresql://cmis:cmis@localhost:5433/cmis

# --- Embeddings (I1 BGE) ---
CMIS_EMBEDDER=bge
CMIS_RELEVANCE_THRESHOLD=0.62
CMIS_MAX_INJECT_COUNT=5

# --- Hybrid retrieval (I4) ---
CMIS_QUERY_NORMALIZE=1
CMIS_HYBRID_RETRIEVAL=1
CMIS_RRF_K=60
CMIS_RETRIEVAL_POOL=50
CMIS_RERANKER=local
CMIS_RERANK_TOP_K=10

# --- HTTP API ---
CMIS_API_HOST=127.0.0.1
CMIS_API_PORT=8000
CMIS_API_RELOAD=0
CMIS_CORS_ORIGINS=http://localhost:5173

# --- Auth (M6) ---
CMIS_JWT_SECRET=dev-secret-change-me
CMIS_JWT_ISSUER=cmis
CMIS_JWT_AUDIENCE=cmis-api
# CMIS_AUTH_DISABLED=1

# --- LLM chat (M7) ---
CMIS_LLM_PROVIDER=mock
# CMIS_LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# --- Temporal workflows (M9) ---
CMIS_USE_TEMPORAL=0
CMIS_TEMPORAL_HOST=localhost:7233
CMIS_TEMPORAL_NAMESPACE=default
CMIS_TEMPORAL_TASK_QUEUE=cmis-background

# --- Redis cache (I2) ---
# REDIS_URL=redis://localhost:6379/0
# CMIS_CONTEXT_CACHE=1
# CMIS_CONTEXT_CACHE_TTL=300

# --- Observability (I3) ---
# PostHog product events (leave empty to disable)
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# Grafana Cloud: no app env vars for scrape — Hosted Collector still requires a dummy token
# Set the same value in Grafana as Bearer token or Basic password
# CMIS_METRICS_TOKEN=cmis-scrape
